{
  ".open-with .select-list": {
    "enter": "open-with:open",
    "ctrl-enter": "open-with:new-window",
    "alt-enter": "open-with:detached-window"
  },
  ".open-with .select-list lumine-text-editor[mini]": {
    "enter": "open-with:open",
    "ctrl-enter": "open-with:new-window",
    "alt-enter": "open-with:detached-window"
  },
  ".open-with.directory .select-list": {
    "shift-enter": "open-with:this-window"
  },
  ".open-with.directory .select-list lumine-text-editor[mini]": {
    "shift-enter": "open-with:this-window"
  }
}
