{
  ".tree-view": {
    "alt-enter": "launcher:open-resource"
  },
  ".launcher .select-list": {
    "enter": "core:confirm"
  },
  ".launcher .select-list lumine-text-editor[mini]": {
    "enter": "core:confirm"
  },
  ".launcher:not(.launcher-new) .select-list": {
    "cmdorctrl-enter": "launcher:open-new-window",
    "alt-enter": "launcher:open-detached-window"
  },
  ".launcher:not(.launcher-new) .select-list lumine-text-editor[mini]": {
    "cmdorctrl-enter": "launcher:open-new-window",
    "alt-enter": "launcher:open-detached-window"
  },
  ".launcher.directory .select-list": {
    "shift-enter": "launcher:open-this-window"
  },
  ".launcher.directory .select-list lumine-text-editor[mini]": {
    "shift-enter": "launcher:open-this-window"
  }
}
