{
  "name": "launcher",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Create workspace content and choose how and where to open resources.",
  "keywords": [
    "notebook",
    "terminal",
    "viewer",
    "opener",
    "workspace"
  ],
  "repository": "https://github.com/lumine-code/launcher",
  "bugs": {
    "url": "https://github.com/lumine-code/launcher/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "specPackages": [
    "tree-view",
    "open-external",
    "jupyter-view",
    "terminal",
    "graviss"
  ],
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    },
    "launcher": {
      "versions": {
        "1.1.0": "provideLauncher"
      }
    }
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    },
    "launcher.provider": {
      "versions": {
        "^1.0.0": "consumeLauncher"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
